{% set anchorPrefix = '' if page.url == '/' else '/' %}
{% set canonicalPath = canonicalPath or page.url %}
{% set ogImage = ogImage or '/assets/og/inicio.jpg' %}
{% set ogImageAlt = ogImageAlt or 'TecRural — Innovación con raíces' %}<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f6f7f1">
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}{{ canonicalPath }}">
  <meta property="og:locale" content="es_ES">
  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ ogDescription or description }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ canonicalPath }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:image" content="{{ site.url }}{{ ogImage }}">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ ogImageAlt }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ site.url }}{{ ogImage }}">
  <meta name="twitter:title" content="{{ ogTitle or title }}">
  <meta name="twitter:description" content="{{ ogDescription or description }}">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <title>{{ title }}</title>
  <link rel="icon" href="/assets/tecrural-icon.webp" type="image/webp">
  {% if heroPreload %}<link rel="preload" as="image" href="{{ heroPreload }}" fetchpriority="high">{% endif %}
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }} · Recursos" href="{{ site.url }}{{ site.feed }}">
  {% block headExtra %}{% endblock %}
  <style>html.mobile-menu-open,body.mobile-menu-open{overflow:hidden}</style>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600;700&family=Manrope:wght@700;800&display=swap" rel="stylesheet">
  {% block styles %}{% endblock %}
</head>
<body>
  <a class="skip-link" href="{{ anchorPrefix }}#inicio">Saltar al contenido principal</a>
  {% include "partials/header.njk" %}
  <main id="inicio">{% block content %}{{ content | safe }}{% endblock %}</main>
  {% include "partials/footer.njk" %}
  {% include "partials/mobile-cta.njk" %}
  <script defer src="/assets/site.js"></script>
</body>
</html>
