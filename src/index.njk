    .faq summary{cursor:pointer;font:700 16px/1.4 Manrope,sans-serif;color:var(--forest);padding:17px 0;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:14px}
    .faq summary::-webkit-details-marker{display:none}
