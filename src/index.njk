    .research-card .more{margin-top:auto}
    @media(max-width:850px){.research-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media(max-width:600px){.research-grid{grid-template-columns:1fr;gap:10px}.research-card{min-height:0;padding:18px}}

    .faq{max-width:900px;margin:0 auto}
