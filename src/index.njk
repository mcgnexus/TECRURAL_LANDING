      .service .more{font-size:13px}
      .plan h3,.step h3{font-size:14px}
      .step-n,.founder-tags span{font-size:12px}
      .footer-copy{font-size:12px}
    }
    @media(max-width:360px){.region-list{font-size:13px}.nav .nav-cta{font-size:10px}}

    .research-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
    .research-card{display:flex;flex-direction:column;min-height:185px;padding:21px;border:1px solid var(--line);border-radius:14px;background:#fff;transition:transform .2s,box-shadow .2s}
    .research-card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
    .research-card h3{font:700 16px/1.3 Manrope,sans-serif;color:var(--forest);margin:9px 0}
