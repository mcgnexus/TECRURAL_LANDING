    .hero-note,.photo-label,.proof{font-size:13px}
    .service p,.cta p,.contact p,.founder-copy p,.region-copy p{font-size:15px}
    .service .more,.plan p,.plan-note,.step p,.region-list,.contact small,.disclaimer,footer{font-size:12px}
    .plan h3,.step h3{font-size:14px}
    .step-n,.founder-tags span{font-size:12px}
    .research-card p{font-size:14px}
    .section-head>p{font-size:16px}
    @media(max-width:760px){
      .service p,.cta p,.contact p,.founder-copy p,.region-copy p{font-size:14px}
      .section-head>p{font-size:15px}
      .plan p,.step p,.region-list{font-size:13px}
    }
    @media(max-width:600px){
      .hero-note,.photo-label,.proof,.plan-note,.contact small,.disclaimer{font-size:12px!important}
